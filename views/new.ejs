<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Post - Posty</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>📝 Posty Blog</h1>
            <a href="/" class="btn">← Back to Posts</a>
        </header>

        <main>
            <div class="form-container">
                <h2>Create New Post</h2>
                <form action="/new" method="POST">
                    <div class="form-group">
                        <label for="title">Title</label>
                        <input type="text" id="title" name="title" required placeholder="Enter post title">
                    </div>
                    
                    <div class="form-group">
                        <label for="content">Content (Markdown supported)</label>
                        <textarea id="content" name="content" rows="15" required placeholder="Write your post content here...

You can use Markdown formatting:
- **bold text**
- *italic text*
- [links](https://example.com)
- ## headings
- - bullet lists"></textarea>
                    </div>
                    
                    <button type="submit" class="btn btn-primary">Publish Post</button>
                </form>
            </div>
        </main>
    </div>
</body>
</html>
